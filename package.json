{
  "name": "winston-newrelic-agent-transport",
  "version": "2.1.0",
  "description": "A Winston transport using the New Relic agent.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimnetics/winston-newrelic-agent-transport.git"
  },
  "keywords": [
    "newrelic",
    "winston"
  ],
  "bugs": {
    "url": "https://github.com/kimnetics/winston-newrelic-agent-transport/issues"
  },
  "homepage": "https://github.com/kimnetics/winston-newrelic-agent-transport#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "newrelic": "14.3.3",
    "triple-beam": "^1.4.1",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/newrelic": "^9.14.8",
    "@types/sinon": "^22.0.0",
    "chai": "^5.3.3",
    "eslint": "^8.57.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "mocha": "^11.7.6",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "diff": "9.0.0",
    "esbuild": "0.28.1",
    "minimatch@^9": "9.0.9",
    "serialize-javascript": "7.0.7"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --ext .ts",
    "test": "NEW_RELIC_ENABLED=false mocha"
  },
  "author": "Gregory Kim <gkim@kimnetics.com>",
  "license": "MIT",
  "allowScripts": {
    "@newrelic/fn-inspect@5.1.0": true,
    "@newrelic/native-metrics@13.1.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
